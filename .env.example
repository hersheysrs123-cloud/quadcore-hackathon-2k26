# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase (Project Settings -> API Keys) --------------------------------
# Safe to expose: NEXT_PUBLIC_* is compiled into the browser bundle.
# Takes either the newer publishable key (sb_publishable_*) or the legacy anon
# JWT — supabase-js accepts both in this slot.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Server-only ------------------------------------------------------------
# The secret key (sb_secret_*, formerly service_role). Bypasses Row Level
# Security. Never prefix this with NEXT_PUBLIC_ and never import it from a
# component — only /app/api/**/route.js should ever see it.
#
# Leave it UNSET rather than filled with a placeholder: the API routes fall back
# to the publishable key when it's absent, but a junk value gets used verbatim
# and fails auth.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google AI Studio (Gemini) ----------------------------------------------
# Powers the Socratic diagnostic and the widget generator. Get one at
# https://aistudio.google.com/apikey. Server-only — never NEXT_PUBLIC_.
GOOGLE_API_KEY=
